# ════════════════════════════════════════════════════════════════
#  YouTube → TikTok Bot  ─  Environment Configuration
#  Copy this file to `.env` and fill in your actual credentials.
#  NEVER commit your real .env file to version control.
# ════════════════════════════════════════════════════════════════


# ── YouTube Settings ─────────────────────────────────────────────
# The channel ID to monitor (NOT the handle/@username).
# Find it at: https://www.youtube.com/account_advanced
# Or via: https://commentpicker.com/youtube-channel-id.php
YOUTUBE_CHANNEL_ID=@HadelFilms


# How often to check the RSS feed (seconds). Default = 10 minutes.
POLL_INTERVAL_SECONDS=600


# ── TikTok OAuth 2.0 Credentials ────────────────────────────────
# Obtain from: https://developers.tiktok.com/  → Your App → Keys & tokens
TIKTOK_CLIENT_KEY=aw1234567890abcdef
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Long-lived access token (obtained after completing the OAuth flow).
# The bot will use the refresh token to renew it automatically.
TIKTOK_ACCESS_TOKEN=act.example_access_token_here

# Refresh token (from the initial OAuth code exchange)
TIKTOK_REFRESH_TOKEN=rft.example_refresh_token_here


# ── Video Processing ─────────────────────────────────────────────
# Target vertical resolution for TikTok (portrait 9:16)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920

# Maximum caption length (TikTok allows up to 2200 characters)
TIKTOK_CAPTION_MAX_LEN=2200

# Hashtags automatically appended to every TikTok post caption.
# Separate multiple tags with spaces.
AUTO_HASHTAGS=#trending #viral #shorts #fyp #foryou


# ── Directories ──────────────────────────────────────────────────
DOWNLOADS_DIR=./downloads
PROCESSED_DIR=./processed

# JSON file tracking which videos have been processed
STATE_FILE=./processed_videos.json


# ── Upload Settings ───────────────────────────────────────────────
# Chunk size for TikTok chunked upload (bytes). Default = 10 MB.
CHUNK_SIZE_BYTES=10485760

# Delete raw + processed files after a successful TikTok upload?
# Set to false to retain files for debugging.
CLEANUP_AFTER_UPLOAD=true
